# deploy/.env 로 복사한 뒤 값을 채워서 EC2에 둘 것 (커밋 금지)
DB_URL=jdbc:mysql://<rds-endpoint>:3306/lab_calendar?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=admin
DB_PASSWORD=changeme
CERTBOT_EMAIL=you@example.com

# ── 공용 비밀번호 인증 (KAN-34) ─────────────────────────────
# 편집용·조회용 비밀번호의 BCrypt 해시. 평문 비밀번호는 어디에도 적지 않는다.
# 만드는 방법과 바꾸는 절차는 README.md 의 "공용 비밀번호" 절 참고.
#
# ⚠ 반드시 작은따옴표로 감쌀 것.
#    BCrypt 해시는 $2a$10$... 처럼 $ 가 들어 있어서 따옴표가 없으면
#    Compose 가 $2a 를 변수로 해석해 값이 잘린 채 전달된다.
#
# 두 해시가 같으면 앱이 기동하지 않는다 (조회 등급이 편집 권한을 갖는 사고 방지).
AUTH_EDITOR_PASSWORD_HASH='$2a$10$replace-with-the-editor-hash'
AUTH_VIEWER_PASSWORD_HASH='$2a$10$replace-with-the-viewer-hash'

# 세션 토큰 서명 키. 32자 이상, 바꾸면 발급된 세션이 전부 만료된다.
#   openssl rand -base64 48
AUTH_TOKEN_SECRET='replace-with-a-long-random-string'
