# deploy/.env 로 복사한 뒤 값을 채워서 서버에 둘 것 (커밋 금지)
# DB는 같은 Compose 안의 mysql 컨테이너. 접속 주소는 docker-compose.yml 에 고정돼 있다.
# 최초 기동 때 이 값으로 계정이 만들어지므로, 그 뒤에 바꾸려면 MySQL 안에서도 바꿔야 한다.
DB_USERNAME=lab_calendar
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme-root
CERTBOT_EMAIL=you@example.com

# ── 공용 비밀번호 인증 (KAN-34) ─────────────────────────────
# 편집용·조회용 비밀번호의 BCrypt 해시. 평문 비밀번호는 어디에도 적지 않는다.
# 만드는 방법과 바꾸는 절차는 README.md 의 "공용 비밀번호" 절 참고.
#
# ⚠ 반드시 작은따옴표로 감쌀 것.
#    BCrypt 해시는 $2a$10$... 처럼 $ 가 들어 있어서 따옴표가 없으면
#    Compose 가 $2a 를 변수로 해석해 값이 잘린 채 전달된다.
#
# 두 해시가 같으면 앱이 기동하지 않는다 (조회 등급이 편집 권한을 갖는 사고 방지).
AUTH_EDITOR_PASSWORD_HASH='$2a$10$replace-with-the-editor-hash'
AUTH_VIEWER_PASSWORD_HASH='$2a$10$replace-with-the-viewer-hash'

# 세션 토큰 서명 키. 32자 이상, 바꾸면 발급된 세션이 전부 만료된다.
#   openssl rand -base64 48
AUTH_TOKEN_SECRET='replace-with-a-long-random-string'

# ── 구글 시트 자동 동기화 (KAN-88, KAN-89) ──────────────────
# 비워 두면 꺼진 채로 돈다. 켜려면 셋 다 채워야 하고, 하나라도 비면 기동을 거부한다.
#
# 키(JSON)는 그대로 넣지 말고 base64 한 줄로 만들어 넣는다. 원본은 줄이 여러 개이고
# 개인키 안에 $ 와 따옴표가 섞여 있어 .env 를 지나면서 잘린다.
#   base64 -w0 lab-calendar-sheets.json
SHEETS_SYNC_ENABLED=false
SHEETS_SPREADSHEET_ID=
SHEETS_CREDENTIALS_JSON=
